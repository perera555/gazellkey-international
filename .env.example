# Copy to .env and fill in. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gazellekey"

# Secret for login tokens - at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JOSE_SECRET=""

# First administrator, used by: npm run seed
ADMIN_EMAIL="admin@gazellekey.com"
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME="System"
ADMIN_LAST_NAME="Administrator"

# "Sign in with Google" for website customers (see lib/google.ts).
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application),
# with GOOGLE_REDIRECT_URI added under "Authorised redirect URIs".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3002/api/auth/google/callback"
# Customer website address, where visitors return after Google sign-in
WEBSITE_URL="http://localhost:3002"

# ── Online shop payments (lib/shop.ts) ──
# Each method appears at checkout only when its settings below are filled in.

# 1) PayHere - cards from Sri Lanka and abroad (Visa, Mastercard, Amex) and
#    local wallets, charged in LKR or USD, paid into your Sri Lankan bank.
#    PayHere portal > Settings > Domains & Credentials (add the website's domain).
#    Free test account: https://sandbox.payhere.lk
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_SANDBOX="true"
# Where PayHere confirms payments. Must be reachable from the internet; default
# is WEBSITE_URL/api/shop/payhere/notify. On a dev machine use a tunnel, e.g.
#   ngrok http 3100  ->  https://xxxx.ngrok-free.app/api/shop/payhere/notify
PAYHERE_NOTIFY_URL=""
# Optional Business App (portal > Settings > Business Apps, permissions:
# Payment Retrieval + Refund). Lets the site check payments itself (works on
# localhost too) and lets Finance refund cards from the admin portal.
PAYHERE_APP_ID=""
PAYHERE_APP_SECRET=""

# 2) Stripe - international cards. Only for a company registered in a country
#    Stripe supports (not Sri Lanka): https://stripe.com/global
# Stripe dashboard > Developers > API keys: use the sk_test_ key while testing.
STRIPE_SECRET_KEY=""
# Stripe dashboard > Developers > Webhooks > add endpoint
#   https://<this API's address>/api/shop/webhook
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired
# then paste its signing secret (whsec_...). On a dev machine run
#   stripe listen --forward-to localhost:3100/api/shop/webhook
# and use the whsec_ it prints.
STRIPE_WEBHOOK_SECRET=""

# 3) Bank transfer - local or international (SWIFT). Shown to the customer
#    line by line; Finance confirms the payment in the admin portal.
#    Name, number and bank are required, the rest is optional.
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_NAME=""
BANK_BRANCH=""
BANK_SWIFT_CODE=""
BANK_ADDRESS=""
BANK_TRANSFER_NOTE=""
# Days the items are held while the transfer arrives (default 3)
BANK_TRANSFER_HOLD_DAYS="3"

# Uploaded documents (outside /public). Default: ./storage
STORAGE_DIR=""

# Also send customers an SMS next to each email (needs Notify.lk below)
SMS_ENABLED="false"

# SMS through Notify.lk (lib/sms.ts): app.notify.lk -> Settings -> API keys.
# Sender ID: your approved sender name ("NotifyDEMO" while testing).
NOTIFYLK_USER_ID=""
NOTIFYLK_API_KEY=""
NOTIFYLK_SENDER_ID="NotifyDEMO"

# Office alerts (lib/officeAlerts.ts): new appointments and enquiries are
# texted to this phone, e.g. "0771234567". Empty = no office SMS.
OFFICE_ALERT_PHONE=""
# Admin portal address, used in the links inside those alerts
ADMIN_URL="http://localhost:3001"

# Google Calendar (lib/googleCalendar.ts): new appointment requests (yellow,
# "To confirm"), confirmed appointments (green) and a "Reply to enquiry"
# reminder for each enquiry go to this calendar. Staff who add it to the
# Google Calendar app on their phone get the pop-up reminders.
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
